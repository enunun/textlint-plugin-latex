{
  "name": "@enunun/textlint-plugin-latex",
  "version": "0.1.0",
  "description": "textlint plugin for LaTeX documents, with support for math-heavy writing such as display math inside sentences and theorem environments",
  "keywords": [
    "textlint",
    "textlintplugin",
    "plugin",
    "latex",
    "tex"
  ],
  "homepage": "https://github.com/enunun/textlint-plugin-latex",
  "bugs": {
    "url": "https://github.com/enunun/textlint-plugin-latex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enunun/textlint-plugin-latex.git"
  },
  "license": "MIT",
  "author": "enunun",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "tsc -p tsconfig.build.json",
    "lint:text": "git ls-files '*.md' -z | xargs -0 -r textlint",
    "lint:markdown": "git ls-files '*.md' -z | xargs -0 -r markdownlint-cli2",
    "lint": "pnpm run lint:text && pnpm run lint:markdown"
  },
  "dependencies": {
    "@textlint/ast-node-types": "^15.8.0",
    "latex-utensils": "^7.0.0"
  },
  "devDependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@textlint/ast-tester": "^15.8.0",
    "@textlint/kernel": "^15.8.0",
    "@textlint/types": "^15.8.0",
    "@types/node": "^26.6.3",
    "markdownlint-cli2": "^0.23.3",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-ja-space-around-code": "^3.0.3",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.3",
    "textlint-rule-preset-ja-spacing": "^3.0.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "textlint": ">=14.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
